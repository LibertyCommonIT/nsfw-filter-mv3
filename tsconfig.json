{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["DOM", "ESNext"],
    "sourceMap": false,
    "rootDir": "./src",
    "outDir": "./dist/src",
    "paths": {
      "popup/*": ["./src/popup/*"]
    },
    "strict": true,
    "strictNullChecks": true,
    "alwaysStrict": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "removeComments": true,
    "allowJs": false,
    "checkJs": false,
    "jsx": "react",
    "esModuleInterop": true
  },
  "include": ["src/"],
  "exclude": ["node_modules/", "dist/", "test/"]
}